<?xml version="1.0" encoding="utf-8"?>
<!-- Network security config: cleartext HTTP disabled. All connections use HTTPS.
     Per-server TLS fingerprint pinning is enforced in PinnedTrustManager. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
