<?xml version="1.0" encoding="utf-8"?>
<!-- Homelab Pocket — Matrix Host Node Card -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_matrix"
    android:padding="14dp"
    android:layout_marginBottom="8dp">

    <!-- Header: host name + status chip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_node_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="@color/matrix_text_primary" />

        <TextView
            android:id="@+id/tv_node_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_running"
            android:textColor="@color/matrix_phosphor"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- PVE / PDM version + uptime -->
    <TextView
        android:id="@+id/tv_node_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:textColor="@color/matrix_text_muted"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="8dp" />

    <!-- Offline notification (displayed when node is offline) -->
    <TextView
        android:id="@+id/tv_offline_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/matrix_amber_dim"
        android:textColor="@color/matrix_amber"
        android:padding="8dp"
        android:textSize="12sp"
        android:text="@string/node_offline_msg"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <!-- Metrics layout (visible when online) -->
    <LinearLayout
        android:id="@+id/layout_metrics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- CPU bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tv_cpu_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CPU"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="@color/matrix_text_secondary" />
            <TextView
                android:id="@+id/tv_cpu_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0%"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textColor="@color/matrix_phosphor" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_cpu"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/matrix_phosphor"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp" />

        <!-- RAM bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tv_ram_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="RAM"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="@color/matrix_text_secondary" />
            <TextView
                android:id="@+id/tv_ram_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 0"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textColor="@color/matrix_cyan" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_ram"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/matrix_cyan"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp" />

        <!-- Disk and Net rates -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tv_node_disk"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="@color/matrix_text_secondary" />
            <TextView
                android:id="@+id/tv_node_net"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="@color/matrix_text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Actions (PDM monitoring badge or host shell button; independent of metrics layout) -->
    <LinearLayout
        android:id="@+id/layout_node_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/tv_node_pdm_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pdm_monitoring_badge"
            android:textColor="@color/matrix_cyan"
            android:background="@drawable/bg_chip_lxc"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_node_shell"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:text="@string/node_terminal"
            android:background="@drawable/bg_btn_outline"
            android:textColor="@color/matrix_phosphor"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
