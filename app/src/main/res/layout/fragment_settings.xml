<?xml version="1.0" encoding="utf-8"?>
<!-- Homelab Pocket — Matrix Settings & Server Management Fragment -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/matrix_obsidian">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/matrix_surface"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_title"
            android:textColor="@color/matrix_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_add_server"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:text="@string/add_server"
            android:textColor="@color/matrix_phosphor"
            android:background="?android:attr/selectableItemBackground"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/matrix_surface_border" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Section 1: Server Connections -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/servers_title"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textColor="@color/matrix_phosphor"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/layout_server_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp" />


            <!-- Section 2: Telemetry Auto-Refresh Cadence -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_matrix"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TELEMETRY AUTO-REFRESH"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textColor="@color/matrix_phosphor"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cadence target represents foreground polling frequency, not hypervisor data freshness. Upstream metrics (particularly on Proxmox Datacenter Manager) are gathered at PDM\'s internal collection cycle (~10s–30s)."
                    android:textSize="11sp"
                    android:textColor="@color/matrix_text_secondary"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_refresh_off"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_target_min"
                        android:layout_weight="1"
                        android:text="Off"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/matrix_text_secondary"
                        android:background="@drawable/bg_btn_outline"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_refresh_5s"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_target_min"
                        android:layout_weight="1"
                        android:text="5s"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/matrix_text_secondary"
                        android:background="@drawable/bg_btn_outline"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_refresh_10s"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_target_min"
                        android:layout_weight="1"
                        android:text="10s"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/matrix_obsidian"
                        android:background="@drawable/bg_btn_phosphor"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_refresh_30s"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_target_min"
                        android:layout_weight="1"
                        android:text="30s"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/matrix_text_secondary"
                        android:background="@drawable/bg_btn_outline"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_refresh_60s"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_target_min"
                        android:layout_weight="1"
                        android:text="60s"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/matrix_text_secondary"
                        android:background="@drawable/bg_btn_outline" />
                </LinearLayout>

            </LinearLayout>

            <!-- Section 3: Security & Session -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_matrix"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SECURITY INSTRUMENT"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textColor="@color/matrix_cyan"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Credentials stored exclusively in hardware-backed Android Keystore using AES-256-GCM. Pinned TLS fingerprints strictly validated on each handshake."
                    android:textSize="11sp"
                    android:textColor="@color/matrix_text_secondary"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_lock_session"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:text="@string/session_lock"
                    android:background="@drawable/bg_btn_outline"
                    android:textColor="@color/matrix_amber"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Section 4: Architecture & Version Info -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PVE Pocket v0.1.5-alpha (GPL-3.0-or-later)\nInternal Package: com.homelabpocket (legacy namespace preserved for upgrade continuity)\nLocal Keystore Storage • Zero Analytics • Fully Open Source"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="@color/matrix_text_muted"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
