<?xml version="1.0" encoding="utf-8"?>
<!-- Homelab Pocket — Node Detail Activity with Storage Pools and Hosted Guests -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/matrix_obsidian">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/matrix_surface"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:text="&lt; HOSTS"
            android:textColor="@color/matrix_phosphor"
            android:background="?android:attr/selectableItemBackground"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tv_detail_node_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="@color/matrix_text_primary"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/tv_detail_pdm_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pdm_monitoring_badge"
            android:textColor="@color/matrix_cyan"
            android:background="@drawable/bg_chip_lxc"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_detail_shell"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:text="@string/node_terminal"
            android:textColor="@color/matrix_obsidian"
            android:background="@drawable/bg_btn_phosphor"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/matrix_surface_border" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Hardware Telemetry Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_matrix"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HARDWARE TELEMETRY"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textColor="@color/matrix_phosphor"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tv_detail_cpu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CPU: -"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/matrix_text_primary" />

                <ProgressBar
                    android:id="@+id/progress_detail_cpu"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:max="100"
                    android:progressTint="@color/matrix_phosphor"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tv_detail_ram"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RAM: -"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/matrix_text_primary" />

                <ProgressBar
                    android:id="@+id/progress_detail_ram"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:max="100"
                    android:progressTint="@color/matrix_cyan"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tv_detail_disk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Root FS (/): -"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/matrix_text_primary" />

                <ProgressBar
                    android:id="@+id/progress_detail_disk"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:max="100"
                    android:progressTint="@color/matrix_cyan"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="* Root filesystem only. Configured storage pools listed below."
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/matrix_text_muted"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tv_detail_uptime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Uptime: -"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/matrix_text_secondary"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_detail_pve_ver"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Release: -"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/matrix_text_secondary" />
            </LinearLayout>

            <!-- Configured Storage Pools Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONFIGURED STORAGE POOLS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textColor="@color/matrix_phosphor"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pools &amp; datastores reported per-pool to avoid double-counting shared storage."
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textColor="@color/matrix_text_muted"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/layout_detail_storage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="14dp" />

            <!-- Hosted Guests Container -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HOSTED GUEST INSTANCES"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textColor="@color/matrix_cyan"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/layout_detail_guests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
