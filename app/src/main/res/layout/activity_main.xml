<?xml version="1.0" encoding="utf-8"?>
<!-- Homelab Pocket — Main Matrix Operations Activity -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/matrix_obsidian">

    <!-- Content frame for Fragments / Views -->
    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom navigation 1dp border -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/matrix_surface_border" />

    <!-- Bottom navigation bar (48dp+ touch target per tab) -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:orientation="horizontal"
        android:background="@color/matrix_surface">

        <Button
            android:id="@+id/nav_dashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/nav_dashboard"
            android:background="?android:attr/selectableItemBackground"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/matrix_phosphor"
            android:gravity="center"
            android:drawableTop="@drawable/ic_dashboard"
            android:drawablePadding="2dp"
            android:minHeight="@dimen/touch_target_min" />

        <Button
            android:id="@+id/nav_nodes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/nav_nodes"
            android:background="?android:attr/selectableItemBackground"
            android:textSize="11sp"
            android:textColor="@color/matrix_text_secondary"
            android:gravity="center"
            android:drawableTop="@drawable/ic_server"
            android:drawablePadding="2dp"
            android:minHeight="@dimen/touch_target_min" />

        <Button
            android:id="@+id/nav_guests"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/nav_guests"
            android:background="?android:attr/selectableItemBackground"
            android:textSize="11sp"
            android:textColor="@color/matrix_text_secondary"
            android:gravity="center"
            android:drawableTop="@drawable/ic_vm"
            android:drawablePadding="2dp"
            android:minHeight="@dimen/touch_target_min" />

        <Button
            android:id="@+id/nav_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/nav_settings"
            android:background="?android:attr/selectableItemBackground"
            android:textSize="11sp"
            android:textColor="@color/matrix_text_secondary"
            android:gravity="center"
            android:drawableTop="@drawable/ic_settings"
            android:drawablePadding="2dp"
            android:minHeight="@dimen/touch_target_min" />
    </LinearLayout>

</LinearLayout>
