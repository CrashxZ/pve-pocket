<?xml version="1.0" encoding="utf-8"?>
<!-- Homelab Pocket — Matrix Guest (VM/LXC) Card -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_matrix"
    android:padding="14dp"
    android:layout_marginBottom="8dp">

    <!-- Row 1: Favorite Star + VMID + Name + Type Badge + Status Chip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Favorite Toggle Star (48dp touch target) -->
        <ImageButton
            android:id="@+id/btn_favorite"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_star"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/favorite_add"
            android:tint="@color/matrix_text_muted" />

        <!-- VMID & Guest Name -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:id="@+id/tv_guest_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/matrix_text_primary" />

            <TextView
                android:id="@+id/tv_guest_vmid_node"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="@color/matrix_text_secondary" />
        </LinearLayout>

        <!-- Type Badge (LXC vs QEMU) -->
        <TextView
            android:id="@+id/tv_guest_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_lxc"
            android:textColor="@color/matrix_cyan"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginEnd="6dp" />

        <!-- Status Chip (RUNNING / STOPPED) -->
        <TextView
            android:id="@+id/tv_guest_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_running"
            android:textColor="@color/matrix_phosphor"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Metrics Row (Visible when running) -->
    <LinearLayout
        android:id="@+id/layout_guest_metrics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tv_guest_cpu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="@color/matrix_phosphor" />
            <TextView
                android:id="@+id/tv_guest_ram"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="@color/matrix_cyan" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_guest_cpu"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/matrix_phosphor"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="6dp" />
    </LinearLayout>

    <!-- Power & Terminal Action Buttons (Horizontal scroll for small screens) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Start Button -->
            <Button
                android:id="@+id/btn_guest_start"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:text="@string/action_start"
                android:textColor="@color/matrix_obsidian"
                android:background="@drawable/bg_btn_phosphor"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginEnd="4dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- Graceful Shutdown -->
            <Button
                android:id="@+id/btn_guest_shutdown"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:text="@string/action_shutdown"
                android:textColor="@color/matrix_text_primary"
                android:background="@drawable/bg_btn_outline"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginEnd="4dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- Reboot -->
            <Button
                android:id="@+id/btn_guest_reboot"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:text="@string/action_reboot"
                android:textColor="@color/matrix_text_primary"
                android:background="@drawable/bg_btn_outline"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginEnd="4dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- Force Stop (Destructive confirmation) -->
            <Button
                android:id="@+id/btn_guest_force_stop"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:text="@string/action_force_stop"
                android:textColor="@color/matrix_danger"
                android:background="@drawable/bg_btn_outline"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginEnd="4dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <!-- Console / Shell Button -->
            <Button
                android:id="@+id/btn_guest_console"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:text="Console"
                android:textColor="@color/matrix_cyan"
                android:background="@drawable/bg_btn_outline"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
