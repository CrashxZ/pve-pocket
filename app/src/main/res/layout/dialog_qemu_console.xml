<?xml version="1.0" encoding="utf-8"?>
<!-- Homelab Pocket — QEMU Console Disclosure Dialog -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_matrix"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/qemu_terminal_unavailable_title"
        android:textColor="@color/matrix_cyan"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tv_qemu_disclosure_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/matrix_text_primary"
        android:textSize="13sp"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btn_open_external_ssh"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target_min"
        android:text="@string/qemu_external_ssh"
        android:textColor="@color/matrix_obsidian"
        android:background="@drawable/bg_btn_phosphor"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_open_browser_vnc"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target_min"
        android:text="@string/qemu_open_browser_console"
        android:textColor="@color/matrix_cyan"
        android:background="@drawable/bg_btn_outline"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_close_disclosure"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target_min"
        android:text="@string/confirm_cancel"
        android:textColor="@color/matrix_text_secondary"
        android:background="?android:attr/selectableItemBackground"
        android:textSize="13sp" />

</LinearLayout>
